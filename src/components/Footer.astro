---
import { business } from '../data/business';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-divider" aria-hidden="true"></div>
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{business.name}</p>
      <p class="footer-tagline">{business.tagline}</p>
      <p>{business.description}</p>
      <a class="btn btn--outline" href={business.instagram} rel="noopener" target="_blank">
        Follow {business.instagramHandle}
      </a>
    </div>

    <div>
      <h3>Contact</h3>
      <p>
        {business.address.streetAddress}<br />
        {business.address.addressLocality} {business.address.postalCode}, UK
      </p>
      <p><a href={`tel:${business.phone.replace(/\s+/g, '')}`}>{business.phone}</a></p>
      <p>{business.hours.days}, {business.hours.display}</p>
    </div>

    <div>
      <h3>Areas We Serve</h3>
      <ul class="location-list">
        {business.locations.map((location) => <li>{location}</li>)}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {business.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: #fff;
    padding-block: 3.5rem 1.75rem;
    position: relative;
  }

  .footer-divider {
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-gold), transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    margin-top: 1rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.15rem;
  }

  .footer-tagline {
    font-family: var(--font-script);
    font-style: italic;
    color: var(--color-gold-soft);
    margin-bottom: 1rem;
  }

  .site-footer h3 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold-soft);
    margin-bottom: 1rem;
  }

  .site-footer a {
    color: #fff;
  }

  .site-footer p {
    color: rgba(255, 255, 255, 0.75);
  }

  .location-list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .location-list li {
    margin-bottom: 0.5rem;
    break-inside: avoid;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    font-size: 0.85rem;
  }

  .footer-bottom p {
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 780px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
