---
// No per-card "Book Now" button anymore — with four+ of these in a grid it
// read as button clutter. The whole card links to its detail page instead
// (same pattern as ServiceCard), and the one enquiry CTA for the section
// lives once, below the grid, pointing straight to /contact/.
//
// The thumbnail is a placeholder (same visual language as the Gallery
// tiles), not a real product photo — there's no hire-item photography yet.
// Swap the placeholder div for a real <Image> per item once photos exist.
interface Props {
  href: string;
  title: string;
  eyebrow: string;
  items: string[];
}

const { href, title, eyebrow, items } = Astro.props;
---

<a class="card hire-card reveal" href={href}>
  <div class="hire-card__thumb" aria-hidden="true">
    <svg viewBox="0 0 40 40" class="hire-card__thumb-icon" aria-hidden="true">
      <circle cx="20" cy="20" r="18" />
      <path d="M20 10c2.2 2.6 3.4 5 3.4 7.4 0 2.4-1.5 4-3.4 4s-3.4-1.6-3.4-4c0-2.4 1.2-4.8 3.4-7.4Z" />
    </svg>
  </div>
  <span class="hire-card__rule" aria-hidden="true"></span>
  <p class="hire-card__category">{eyebrow}</p>
  <h3>{title}</h3>
  <p class="hire-card__label">Available options</p>
  <ul class="tag-list">
    {items.slice(0, 4).map((item) => <li>{item}</li>)}
  </ul>
  <span class="hire-card__link">
    View details &amp; enquire
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .hire-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .hire-card__thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    margin: -0.5rem -0.35rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--color-bg-alt), var(--color-surface) 70%);
  }

  .hire-card__thumb-icon {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: var(--color-primary-dark);
    stroke-width: 1.1;
    opacity: 0.7;
  }

  .hire-card__rule {
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-primary-dark), var(--color-primary));
    margin-bottom: 0.75rem;
    transition: width 0.35s var(--ease);
  }

  .hire-card:hover .hire-card__rule {
    width: 56px;
  }

  .hire-card__category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-dark);
    margin-bottom: 0.35rem;
  }

  .hire-card__label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .hire-card .tag-list {
    flex-grow: 1;
  }

  .hire-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    color: var(--color-primary-dark);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .hire-card__link svg {
    width: 15px;
    height: 15px;
    transition: transform 0.3s var(--ease);
  }

  .hire-card:hover .hire-card__link svg {
    transform: translateX(4px);
  }
</style>
