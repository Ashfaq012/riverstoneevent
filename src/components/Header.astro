---
import { business } from '../data/business';
import { mainNav } from '../data/nav';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img
        class="brand__mark"
        src="/brand/logo-header.png"
        width="72"
        height="87"
        alt={`${business.name} logo`}
      />
      <span class="brand__text">
        <span class="brand__name">{business.name}</span>
        <span class="brand__tagline">{business.tagline}</span>
      </span>
    </a>
    <nav aria-label="Primary" class="nav-desktop">
      <ul>
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary header-cta" href="/contact/">Enquire Now</a>

    <!--
      Below 860px the desktop nav (above) is hidden entirely — this button
      and panel are the mobile replacement, not decoration. Pure CSS
      couldn't toggle a panel driven by a button elsewhere in the DOM
      without :has() support we don't want to require, so a few lines of
      vanilla JS handle the open/close state.
    -->
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg viewBox="0 0 24 24" class="nav-toggle__icon nav-toggle__icon--open" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <svg viewBox="0 0 24 24" class="nav-toggle__icon nav-toggle__icon--close" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Mobile" class="nav-mobile">
    <ul>
      {mainNav.map((item) => (
        <li>
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a class="btn btn--primary nav-mobile__cta" href="/contact/">Enquire Now</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 245, 245, 0.8);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text);
    min-width: 0;
  }

  .brand__mark {
    width: 40px;
    height: auto;
    flex-shrink: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    min-width: 0;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .brand__tagline {
    font-family: var(--font-script);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-primary-dark);
    white-space: nowrap;
  }

  .nav-desktop ul {
    list-style: none;
    display: flex;
    gap: 1.85rem;
    margin: 0;
    padding: 0;
  }

  .nav-desktop a {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-text);
    position: relative;
    padding-bottom: 4px;
  }

  .nav-desktop a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1.5px;
    background: var(--color-gold);
    transition: right 0.3s var(--ease);
  }

  .nav-desktop a:hover::after {
    right: 0;
  }

  .nav-desktop a[aria-current='page'] {
    color: var(--color-primary-dark);
  }

  .nav-desktop a[aria-current='page']::after {
    right: 0;
  }

  .header-cta {
    white-space: nowrap;
    padding: 0.7rem 1.5rem;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
    cursor: pointer;
    padding: 0;
  }

  .nav-toggle__icon {
    width: 20px;
    height: 20px;
  }

  .nav-toggle__icon--close {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--open {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--close {
    display: block;
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-desktop {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-mobile {
      display: block;
      max-height: 0;
      overflow: hidden;
      border-top: 0 solid var(--color-border);
      background: var(--color-surface);
      transition: max-height 0.3s var(--ease);
    }

    .nav-mobile.is-open {
      max-height: 420px;
      border-top-width: 1px;
    }

    .nav-mobile ul {
      list-style: none;
      margin: 0;
      padding: 1rem 1.5rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .nav-mobile a {
      display: block;
      text-decoration: none;
      font-weight: 500;
      font-size: 1rem;
      color: var(--color-text);
      padding: 0.6rem 0;
    }

    .nav-mobile a[aria-current='page'] {
      color: var(--color-primary-dark);
    }

    .nav-mobile__cta {
      margin-top: 0.5rem;
      text-align: center;
      justify-content: center;
      width: 100%;
    }
  }

  @media (max-width: 420px) {
    .brand__tagline {
      display: none;
    }

    .brand__name {
      font-size: 1.05rem;
    }

    .brand__mark {
      width: 34px;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const panel = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    panel?.classList.toggle('is-open', !isOpen);
  });

  // Close the panel after tapping a link, so navigating doesn't leave it
  // open underneath the next page's header.
  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      panel.classList.remove('is-open');
    });
  });
</script>
