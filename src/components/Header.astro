---
import { business } from '../data/business';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/hire/', label: 'Hire' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <circle cx="16" cy="16" r="15" stroke="currentColor" stroke-width="1" />
          <path
            d="M16 8c1.8 2.2 2.8 4.2 2.8 6.2 0 2-1.2 3.4-2.8 3.4s-2.8-1.4-2.8-3.4C13.2 12.2 14.2 10.2 16 8Z"
            fill="currentColor"
          />
          <path d="M16 17.6V24" stroke="currentColor" stroke-width="1" />
          <path d="M11 21c1.6-1.2 3.3-1.8 5-1.8s3.4.6 5 1.8" stroke="currentColor" stroke-width="1" />
        </svg>
      </span>
      <span class="brand__text">
        <span class="brand__name">{business.name}</span>
        <span class="brand__tagline">{business.tagline}</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary header-cta" href="/contact/">Book Now</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(251, 244, 236, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .brand__mark {
    color: var(--color-primary);
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-ink);
  }

  .brand__tagline {
    font-family: var(--font-script);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-primary-dark);
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.85rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-text);
    position: relative;
    padding-bottom: 4px;
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1.5px;
    background: var(--color-gold);
    transition: right 0.3s var(--ease);
  }

  nav a:hover::after {
    right: 0;
  }

  nav a[aria-current='page'] {
    color: var(--color-primary-dark);
  }

  nav a[aria-current='page']::after {
    right: 0;
  }

  .header-cta {
    white-space: nowrap;
    padding: 0.7rem 1.5rem;
  }

  @media (max-width: 860px) {
    nav {
      display: none;
    }
  }
</style>
