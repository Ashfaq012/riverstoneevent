---
// A hand-drawn-feeling line-art wreath, built from rotated petal paths
// rather than a placeholder photo. Used behind the hero and as the base for
// the gallery/card placeholders so "no real photos yet" still looks
// intentional instead of like a broken image.
interface Props {
  letter?: string;
  class?: string;
}

const { letter = 'R', class: className = '' } = Astro.props;
const petals = Array.from({ length: 10 }, (_, i) => i * 36);
---

<svg
  viewBox="0 0 400 400"
  class={`floral-emblem ${className}`}
  role="img"
  aria-label="Decorative floral emblem"
>
  <circle cx="200" cy="200" r="188" class="floral-emblem__ring" />
  <circle cx="200" cy="200" r="150" class="floral-emblem__ring floral-emblem__ring--soft" />
  <g class="floral-emblem__petals">
    {petals.map((angle) => (
      <path
        d="M200,54 C214,88 214,118 200,138 C186,118 186,88 200,54 Z"
        transform={`rotate(${angle} 200 200)`}
      />
    ))}
  </g>
  <text x="200" y="215" text-anchor="middle" class="floral-emblem__letter">
    {letter}
  </text>
</svg>

<style>
  .floral-emblem {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .floral-emblem__ring {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .floral-emblem__ring--soft {
    stroke: var(--color-gold-soft);
    stroke-dasharray: 2 6;
  }

  .floral-emblem__petals path {
    fill: none;
    stroke: var(--color-gold);
    stroke-width: 1.1;
    opacity: 0.75;
  }

  .floral-emblem__letter {
    font-family: var(--font-script);
    font-style: italic;
    font-size: 108px;
    fill: var(--color-primary);
  }
</style>
