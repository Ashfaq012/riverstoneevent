---
interface Props {
  href: string;
  title: string;
  summary: string;
}

const { href, title, summary } = Astro.props;
---

<a class="card service-card reveal" href={href}>
  <span class="service-card__rule" aria-hidden="true"></span>
  <h3>{title}</h3>
  <p>{summary}</p>
  <span class="service-card__link">
    Learn more
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>

<style>
  .service-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-card__rule {
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-primary-dark), var(--color-primary));
    margin-bottom: 1.1rem;
    transition: width 0.35s var(--ease);
  }

  .service-card:hover .service-card__rule {
    width: 56px;
  }

  .service-card p {
    color: var(--color-muted);
    flex-grow: 1;
  }

  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary-dark);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .service-card__link svg {
    width: 15px;
    height: 15px;
    transition: transform 0.3s var(--ease);
  }

  .service-card:hover .service-card__link svg {
    transform: translateX(4px);
  }
</style>
