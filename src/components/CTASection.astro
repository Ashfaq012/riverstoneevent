---
import { business, whatsappLink } from '../data/business';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const {
  eyebrow = "Let's Create Magic Together",
  title,
  description = `Proudly serving ${business.locations.join(', ')}.`,
} = Astro.props;
---

<section class="section container">
  <div class="cta-banner reveal">
    <svg class="cta-banner__pattern" viewBox="0 0 400 200" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.35">
        <circle cx="40" cy="30" r="18" />
        <circle cx="370" cy="170" r="26" />
        <circle cx="360" cy="20" r="10" />
        <circle cx="20" cy="180" r="12" />
      </g>
    </svg>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{description}</p>
    <div class="cta-actions">
      <a class="btn btn--outline" href="/contact/">Enquire Now</a>
      <a class="btn btn--outline" href={whatsappLink} target="_blank" rel="noopener">
        <WhatsAppIcon class="btn__icon" />
        Chat on WhatsApp
      </a>
      <a class="btn btn--outline" href={business.instagram} target="_blank" rel="noopener">
        <InstagramIcon class="btn__icon" />
        Chat on Instagram
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    isolation: isolate;
  }

  .cta-banner__pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--color-surface);
    z-index: -1;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
</style>
