---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business';
import { breadcrumbSchema } from '../lib/schema';

import seventiethBirthday from '../assets/gallery/seventieth-birthday-celebration.jpg';
import fiftiethBirthday from '../assets/gallery/fiftieth-birthday-celebration.jpg';
import graduationBackdrop from '../assets/gallery/graduation-balloon-backdrop.jpg';
import drapedBackdrop from '../assets/gallery/draped-fabric-backdrop.jpg';
import blushGoldArch from '../assets/gallery/blush-gold-balloon-styling.jpg';
import goldOrangeTablescape from '../assets/gallery/gold-orange-tablescape.jpg';
import floralTableStyling from '../assets/gallery/floral-table-styling.jpg';
import gardenPicnic from '../assets/gallery/garden-picnic-setup.jpg';

// Photos only — no visible titles or captions on the page. The descriptions
// below are alt text: they're what screen readers announce and what search
// engines read for image SEO, so keep them specific and honest about what
// the photo actually shows. To add a photo: drop the (colour-corrected,
// metadata-stripped) file in src/assets/gallery/, import it above, and add
// an entry here.
const photos = [
  {
    src: fiftiethBirthday,
    alt: 'Gold sequin backdrop with a neon Happy Birthday sign, light-up 50 marquee numbers and burgundy, gold and white balloons styled for a 50th birthday',
  },
  {
    src: drapedBackdrop,
    alt: 'Red and cream draped fabric backdrop with a tufted bench, floral arrangements and a gold plinth',
  },
  {
    src: gardenPicnic,
    alt: 'Low picnic table styled in pink and gold with roses, candles and place settings, set on lace rugs and cushions in a garden',
  },
  {
    src: seventiethBirthday,
    alt: 'Navy and gold balloon backdrop with a birthday cake on a plinth, styled for a 70th birthday celebration',
  },
  {
    src: blushGoldArch,
    alt: 'Pink, white and gold balloon arch with florals beside a styled table with white display boxes and flowers',
  },
  {
    src: goldOrangeTablescape,
    alt: 'Round table styled with an orange and gold tablescape, floral centrepiece and place settings',
  },
  {
    src: graduationBackdrop,
    alt: 'Gold and cream balloon arch backdrop with "Congratulations" signage for a graduation celebration',
  },
  {
    src: floralTableStyling,
    alt: 'Vibrant pink, orange and yellow floral table arrangements styled for a celebration',
  },
];

const title = `Gallery | ${business.name}`;
const description = `Real event decoration styled by Riverstone Event, across ${business.locations.join(', ')}.`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'Gallery', url: `${business.url}/gallery/` },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Gallery', href: '/gallery/' }]} />
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Our Portfolio</p>
        <h1>A Showcase of Elegance</h1>
        <p>
          A selection of setups styled by Riverstone Event. Follow along on{' '}
          <a href={business.instagram} target="_blank" rel="noopener">Instagram</a>{' '}
          for more.
        </p>
      </div>

      <div class="gallery-grid">
        {photos.map((photo) => (
          <figure class="gallery-tile reveal">
            <Image src={photo.src} alt={photo.alt} width={480} height={600} />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="See More on Instagram"
    description={`Follow us for daily inspiration and the latest event decorations from ${business.locations.join(', ')}.`}
  />
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .gallery-tile {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .gallery-tile:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }

  .gallery-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .gallery-tile:hover img {
    transform: scale(1.05);
  }
</style>
