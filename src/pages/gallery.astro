---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import { business } from '../data/business';
import { breadcrumbSchema } from '../lib/schema';

// The current site's "gallery" is really an embedded Instagram feed with no
// gallery of its own, and there's no real Riverstone event photography in
// this project to use instead. Rather than leave a bare "coming soon"
// notice, this page is structured as the eventual gallery — one tile per
// category, in the same line-art placeholder style as the hire cards, each
// clearly labelled "Coming soon" so nothing here is mistaken for real
// client work. Swap `categories` for real <Image> entries (grouped the
// same way) once photography exists.
const categories = [
  { name: 'Weddings', caption: 'Ceremony & reception styling', tone: 'primary' },
  { name: 'Birthdays', caption: 'Themed setups for every milestone', tone: 'gold' },
  { name: 'Baby Showers', caption: 'Soft, celebratory styling', tone: 'rose' },
  { name: 'Balloons', caption: 'Arches, garlands & installations', tone: 'gold' },
  { name: 'Backdrops', caption: 'Statement backdrops for any theme', tone: 'primary' },
  { name: 'Tablescapes', caption: 'Beautifully styled table settings', tone: 'rose' },
  { name: 'Floral Styling', caption: 'Fresh & artificial floral design', tone: 'gold' },
  { name: 'Hire Collection', caption: 'Browse pieces available to hire', tone: 'primary', href: '/hire/' },
];

const title = `Gallery | ${business.name}`;
const description = `Event decoration categories from Riverstone Event, styled across ${business.locations.join(', ')}.`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'Gallery', url: `${business.url}/gallery/` },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Gallery', href: '/gallery/' }]} />
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Our Portfolio</p>
        <h1>A Showcase of Elegance</h1>
        <p>
          Real event photography isn't live yet, so this page shows the
          categories our gallery will be organised into — follow along on
          {' '}<a href={business.instagram} target="_blank" rel="noopener">Instagram</a>{' '}
          for real setups in the meantime.
        </p>
      </div>

      <div class="gallery-grid">
        {categories.map((tile) => (
          <figure class={`gallery-tile gallery-tile--${tile.tone} reveal`}>
            <span class="gallery-tile__badge">Coming Soon</span>
            {tile.href ? (
              <a href={tile.href} class="gallery-tile__link">
                <svg viewBox="0 0 40 40" class="gallery-tile__mark" aria-hidden="true">
                  <circle cx="20" cy="20" r="18" />
                  <path d="M20 10c2.2 2.6 3.4 5 3.4 7.4 0 2.4-1.5 4-3.4 4s-3.4-1.6-3.4-4c0-2.4 1.2-4.8 3.4-7.4Z" />
                </svg>
                <figcaption>{tile.name}</figcaption>
                <span class="gallery-tile__caption">{tile.caption}</span>
              </a>
            ) : (
              <>
                <svg viewBox="0 0 40 40" class="gallery-tile__mark" aria-hidden="true">
                  <circle cx="20" cy="20" r="18" />
                  <path d="M20 10c2.2 2.6 3.4 5 3.4 7.4 0 2.4-1.5 4-3.4 4s-3.4-1.6-3.4-4c0-2.4 1.2-4.8 3.4-7.4Z" />
                </svg>
                <figcaption>{tile.name}</figcaption>
                <span class="gallery-tile__caption">{tile.caption}</span>
              </>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="See More on Instagram"
    description={`Follow us for daily inspiration and the latest event decorations from ${business.locations.join(', ')}.`}
  />
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .gallery-tile {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    margin: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-soft);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .gallery-tile:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }

  .gallery-tile--rose {
    background: linear-gradient(160deg, var(--color-bg-alt), var(--color-surface) 70%);
  }

  .gallery-tile--gold {
    background: linear-gradient(160deg, var(--color-primary), var(--color-surface) 70%);
  }

  .gallery-tile--primary {
    background: linear-gradient(160deg, var(--color-primary-dark), var(--color-surface) 70%);
  }

  .gallery-tile__badge {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .gallery-tile__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
  }

  .gallery-tile__mark {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--color-primary-dark);
    stroke-width: 1.1;
    opacity: 0.8;
  }

  .gallery-tile figcaption {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .gallery-tile__caption {
    font-size: 0.82rem;
    color: var(--color-muted);
  }
</style>
