---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import Ornament from '../components/Ornament.astro';
import { business } from '../data/business';
import { breadcrumbSchema } from '../lib/schema';

// Every claim here is either a statement of approach ("we do X") or a
// verifiable fact (address, service area, the range of events catered
// for) — not an unverifiable metric (client rating, years of experience,
// "finest materials") or a superlative ("the best venues"). The event
// range and Watford base are drawn directly from the business's own
// Instagram "Induction" post, not invented. See README's Content
// Integrity note if this file gets edited later.
const whyUs = [
  {
    title: 'Every Event, Every Size',
    body: "From a kids' birthday to a full wedding, small gathering to large celebration — we design and style whatever you're planning.",
  },
  {
    title: 'Your Colours, Your Style',
    body: 'Pick your own colour palette and decoration style — we work through the options with you rather than offering one fixed look.',
  },
  {
    title: 'Decoration or Hire',
    body: 'Book full event styling, or hire individual decorative pieces and items to put together your own setup.',
  },
  {
    title: 'Based in Watford',
    body: `We're based in Watford and serve ${business.locations.join(', ')}.`,
  },
];

const values = [
  {
    title: 'Passion',
    body: 'Event styling is something we genuinely enjoy — every project is an opportunity to create a space that reflects the occasion.',
  },
  {
    title: 'Care',
    body: 'We take the time to understand what you want before we plan anything, so the result feels like yours.',
  },
  {
    title: 'Flexibility',
    body: "Full event decoration, dessert table styling, or individual pieces to hire — however you'd like to work with us.",
  },
];

const title = `About Us | ${business.name}`;
const description = `${business.name} is a Watford-based event decor business — decoration, dessert table styling and decorative item hire across London & Hertfordshire.`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'About', url: `${business.url}/about/` },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }]} />
  </div>

  <section class="section about-hero">
    <span class="blob about-hero__blob" aria-hidden="true"></span>
    <div class="container about-intro reveal">
      <p class="eyebrow eyebrow--start">About Riverstone Event</p>
      <h1>Crafting <span class="accent-word">Elegance</span> for Every Celebration</h1>
      <p>
        {business.name} is an event decor business based in Watford. We
        cater to every kind of celebration, from kids' to adults' birthday
        parties, baby showers and bridal showers, engagements, anniversary
        parties, nikkah ceremonies and mehndi, proposals, weddings, picnics
        and more — whatever you're marking, we're happy to help you plan
        it, whether it's a small gathering or a large one.
      </p>
      <p>
        You choose your colours and your preferred decoration style, and
        we work through the options with you from there — including our
        dessert table setups, styled to match. And if you'd rather put
        your own setup together, our decorative items are available to
        hire separately too.
      </p>
      <p>
        Whatever you have in mind, we're here to help design and style it
        — serving {business.locations.join(', ')}.
      </p>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Why Choose Us</p>
        <h2>What Makes Riverstone Event Different</h2>
        <p>
          A personal, detail-led approach to styling — and the flexibility
          to work however suits you.
        </p>
      </div>
      <div class="grid grid--4">
        {whyUs.map((item) => (
          <div class="card reveal">
            <span class="card-rule" aria-hidden="true"></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Ornament />

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Our Values</p>
        <h2>What Drives Us</h2>
      </div>
      <div class="grid grid--3">
        {values.map((item) => (
          <div class="card reveal">
            <span class="card-rule" aria-hidden="true"></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Let's Create Magic Together"
    title="Let's Create Something Beautiful Together"
    description={`Ready to discuss your upcoming event in ${business.locations.join(', ')}? We'd love to hear from you.`}
  />
</BaseLayout>

<style>
  .about-hero {
    overflow: hidden;
  }

  .about-hero__blob {
    width: 380px;
    height: 380px;
    background: var(--color-gold-soft);
    top: -140px;
    right: -100px;
  }

  .about-intro {
    max-width: 760px;
  }

  .card-rule {
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-primary-dark), var(--color-primary));
    margin-bottom: 1.1rem;
  }
</style>
