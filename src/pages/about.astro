---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTASection from '../components/CTASection.astro';
import Ornament from '../components/Ornament.astro';
import { business } from '../data/business';
import { breadcrumbSchema } from '../lib/schema';

// Every claim here is either a statement of approach ("we do X") or a
// verifiable fact (address, service area) — not an unverifiable metric
// (client rating, years of experience, "finest materials") or a superlative
// ("the best venues"). See README's Content Integrity note if this file
// gets edited later.
const whyUs = [
  {
    title: 'Personalised Designs',
    body: 'Every project starts with your event, your venue and your preferences — not a fixed template applied to everyone.',
  },
  {
    title: 'Attention to Detail',
    body: 'From colour matching to finishing touches, we work through the details that make a setup feel complete.',
  },
  {
    title: 'On-Time Setup',
    body: "We aim to have everything in place well before your guests arrive.",
  },
  {
    title: 'Based in Watford',
    body: `We're based in Watford and serve ${business.locations.join(', ')}.`,
  },
];

const values = [
  {
    title: 'Passion',
    body: 'Event styling is something we genuinely enjoy — every project is an opportunity to create a space that reflects the occasion.',
  },
  {
    title: 'Care',
    body: 'We take the time to understand what you want before we plan anything, so the result feels like yours.',
  },
  {
    title: 'Flexibility',
    body: "Full event decoration or individual pieces to hire — we work however suits your event and your plans.",
  },
];

const title = `About Us | ${business.name}`;
const description = `About ${business.name} — event decoration, styling and decorative item hire serving ${business.locations.join(', ')}.`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'About', url: `${business.url}/about/` },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }]} />
  </div>

  <section class="section about-hero">
    <span class="blob about-hero__blob" aria-hidden="true"></span>
    <div class="container about-intro reveal">
      <p class="eyebrow eyebrow--start">About Riverstone Event</p>
      <h1>Crafting <span class="accent-word">Elegance</span> for Every Celebration</h1>
      <p>
        At {business.name}, we believe every celebration deserves thoughtful
        styling. We design and set up event decoration built around your
        vision, and we also hire out individual decorative pieces for
        anyone putting together their own setup — two ways of working with
        us, both built around what you actually need.
      </p>
      <p>
        Serving {business.locations.join(', ')}, from intimate gatherings to
        larger celebrations, we put care into understanding your event
        before we plan a single detail.
      </p>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Why Choose Us</p>
        <h2>What Makes Riverstone Event Different</h2>
        <p>
          A personal, detail-led approach to styling — and the flexibility
          to work however suits you.
        </p>
      </div>
      <div class="grid grid--4">
        {whyUs.map((item) => (
          <div class="card reveal">
            <span class="card-rule" aria-hidden="true"></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Ornament />

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Our Values</p>
        <h2>What Drives Us</h2>
      </div>
      <div class="grid grid--3">
        {values.map((item) => (
          <div class="card reveal">
            <span class="card-rule" aria-hidden="true"></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Let's Create Magic Together"
    title="Let's Create Something Beautiful Together"
    description={`Ready to discuss your upcoming event in ${business.locations.join(', ')}? We'd love to hear from you.`}
  />
</BaseLayout>

<style>
  .about-hero {
    overflow: hidden;
  }

  .about-hero__blob {
    width: 380px;
    height: 380px;
    background: var(--color-gold-soft);
    top: -140px;
    right: -100px;
  }

  .about-intro {
    max-width: 760px;
  }

  .card-rule {
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-primary-dark), var(--color-primary));
    margin-bottom: 1.1rem;
  }
</style>
