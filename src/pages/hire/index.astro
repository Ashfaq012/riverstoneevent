---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HireCard from '../../components/HireCard.astro';
import CTASection from '../../components/CTASection.astro';
import { business } from '../../data/business';
import { hireImages } from '../../data/hireImages';
import { breadcrumbSchema } from '../../lib/schema';

const hireItems = (await getCollection('hireItems')).sort(
  (a, b) => a.data.order - b.data.order
);

const title = `Decorative Item Hire | ${business.name}`;
const description = `Hire luxury backdrops, plinths, dessert table setups and flower arches across ${business.locations.join(', ')} — no full decoration booking required.`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'Hire', url: `${business.url}/hire/` },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Hire', href: '/hire/' }]} />
  </div>

  <section class="section">
    <div class="container">
      <div class="section-header reveal">
        <p class="eyebrow">Hire Collection</p>
        <h1>Decorative Item Hire</h1>
        <p>
          Not every event needs a full decoration package. Sometimes you
          only need the right backdrop, plinth, arch or decorative piece
          to complete a setup you're putting together yourself — and you
          don't need to book full event decoration to hire from us.
        </p>
      </div>
      <div class="grid grid--4">
        {hireItems.map((item) => (
          <HireCard
            href={`/hire/${item.id}/`}
            title={item.data.title}
            eyebrow={item.data.eyebrow}
            items={item.data.items}
            image={hireImages[item.id]}
          />
        ))}
      </div>
      <p class="section-cta">
        <a class="btn btn--outline" href="/services/">Looking for full decoration instead?</a>
      </p>
    </div>
  </section>

  <CTASection
    title="Looking for the Perfect Decorative Pieces?"
    description="Tell us which pieces you'd like to hire, your event date and location, and we'll check availability."
  />
</BaseLayout>

<style>
  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.75rem;
  }
</style>
