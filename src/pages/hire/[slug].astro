---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import { business } from '../../data/business';
import { hireImages } from '../../data/hireImages';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const hireItems = await getCollection('hireItems');
  return hireItems.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const url = `${business.url}/hire/${item.id}/`;
const image = hireImages[item.id];
---

<BaseLayout
  title={item.data.seoTitle}
  description={item.data.seoDescription}
  schema={[
    serviceSchema({
      name: item.data.title,
      description: item.data.seoDescription,
      url,
    }),
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'Hire', url: `${business.url}/hire/` },
      { name: item.data.title, url },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs
      crumbs={[
        { name: 'Home', href: '/' },
        { name: 'Hire', href: '/hire/' },
        { name: item.data.title, href: `/hire/${item.id}/` },
      ]}
    />
  </div>

  <article class="section hire-detail">
    <div class="container hire-detail__grid reveal">
      <div class="hire-detail__thumb" class:list={{ 'hire-detail__thumb--photo': !!image }}>
        {image ? (
          <Image src={image.src} alt={image.alt} width={1000} height={440} />
        ) : (
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="18" />
            <path d="M20 10c2.2 2.6 3.4 5 3.4 7.4 0 2.4-1.5 4-3.4 4s-3.4-1.6-3.4-4c0-2.4 1.2-4.8 3.4-7.4Z" />
          </svg>
        )}
      </div>
      <div>
        <span class="hire-detail__rule" aria-hidden="true"></span>
        <p class="eyebrow eyebrow--start">{item.data.eyebrow}</p>
        <h1>{item.data.title}</h1>
        <Content />
        {item.data.items.length > 0 && (
          <>
            <h2 class="hire-detail__options-heading">Available Options</h2>
            <ul class="feature-list">
              {item.data.items.map((line) => <li>{line}</li>)}
            </ul>
          </>
        )}
        <a class="btn btn--primary" href="/contact/">Enquire Now</a>
      </div>
    </div>
  </article>

  <CTASection title={`Ready to Book ${item.data.title}?`} />
</BaseLayout>

<style>
  .hire-detail__grid {
    max-width: 760px;
  }

  .hire-detail__thumb {
    aspect-ratio: 16 / 7;
    border-radius: var(--radius);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(160deg, var(--color-bg-alt), var(--color-surface) 70%);
    overflow: hidden;
  }

  .hire-detail__thumb--photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hire-detail__thumb svg {
    width: 44px;
    height: 44px;
    fill: none;
    stroke: var(--color-primary-dark);
    stroke-width: 1;
    opacity: 0.7;
  }

  .hire-detail__rule {
    display: block;
    width: 48px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-primary-dark), var(--color-primary));
    margin-bottom: 1.25rem;
  }

  .hire-detail__options-heading {
    font-family: var(--font-body);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-top: 1.75rem;
    margin-bottom: 0;
  }
</style>
