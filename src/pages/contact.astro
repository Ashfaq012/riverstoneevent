---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business, whatsappLink } from '../data/business';
import { breadcrumbSchema } from '../lib/schema';
import { eventTypes } from '../data/eventTypes';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import InstagramIcon from '../components/icons/InstagramIcon.astro';

// Kept in sync with the enquiry-type check in the submit script below.
const enquiryTypes = [
  'Event Decoration',
  'Decorative Item Hire',
  'Both',
  'General Enquiry',
];

const title = `Contact Us | ${business.name}`;
const description = `Get in touch with ${business.name} to plan your event across ${business.locations.join(', ')}.`;
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    breadcrumbSchema([
      { name: 'Home', url: business.url },
      { name: 'Contact', url: `${business.url}/contact/` },
    ]),
  ]}
>
  <div class="container">
    <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }]} />
  </div>

  <section class="section">
    <div class="container contact-grid">
      <div class="reveal">
        <p class="eyebrow eyebrow--start">Get In Touch</p>
        <h1>Let's Create Magic Together</h1>
        <p>
          Ready to transform your special day? Fill in the form and we'll
          open WhatsApp with your enquiry ready to send, or message us
          directly on WhatsApp or Instagram for the fastest response.
        </p>

        <div class="contact-quick-actions">
          <a class="btn btn--outline" href={whatsappLink} target="_blank" rel="noopener">
            <WhatsAppIcon class="btn__icon" />
            Chat on WhatsApp
          </a>
          <a class="btn btn--outline" href={business.instagram} target="_blank" rel="noopener">
            <InstagramIcon class="btn__icon" />
            Chat on Instagram
          </a>
        </div>

        <dl class="contact-details">
          <div>
            <dt>Location</dt>
            <dd>
              {business.address.streetAddress}<br />
              {business.address.addressLocality} {business.address.postalCode}, UK
            </dd>
          </div>
          <div>
            <dt>Hours</dt>
            <dd>{business.hours.days}<br />{business.hours.display}</dd>
          </div>
          <div>
            <dt>Call</dt>
            <dd><a href={`tel:${business.phone.replace(/\s+/g, '')}`}>{business.phone}</a></dd>
          </div>
        </dl>

        <ul class="tag-list">
          {business.locations.map((location) => <li>{location}</li>)}
        </ul>
      </div>

      <div class="card contact-form-card reveal">
        <p id="form-success" class="form-banner form-banner--success" hidden>
          WhatsApp is opening in a new tab with your enquiry ready to go —
          just hit send there to reach us.
        </p>
        <p id="form-error" class="form-banner form-banner--error" hidden>
          Couldn't open WhatsApp automatically. Please message us directly
          on WhatsApp or Instagram instead.
        </p>

        <!--
          No backend here — submitting this form builds a wa.me link from
          whatever was filled in and opens WhatsApp with the message
          pre-written. The visitor still has to tap send themselves on
          WhatsApp's side (there's no way to send on someone's behalf
          without that), so this is a hand-off, not a silent submission.
        -->
        <form id="contact-form">
          <!--
            Honeypot: real visitors never see or fill this (hidden + pulled
            out of tab order). The submit script below checks it and, if
            filled, quietly does nothing instead of opening WhatsApp.
          -->
          <div class="visually-hidden" aria-hidden="true">
            <label for="company">Company</label>
            <input
              type="text"
              id="company"
              name="company"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <div class="contact-form-card__row">
            <label>
              Name
              <input type="text" name="name" required maxlength="100" />
            </label>
            <label>
              Email
              <input type="email" name="email" required maxlength="200" />
            </label>
          </div>
          <label>
            Phone / WhatsApp <span class="contact-form-card__optional">(optional)</span>
            <input type="tel" name="phone" maxlength="30" autocomplete="tel" />
          </label>
          <label>
            Enquiry type
            <select name="enquiry-type" required>
              <option value="" disabled selected>Select an option</option>
              {enquiryTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </label>
          <div class="contact-form-card__row">
            <label>
              Event type <span class="contact-form-card__optional">(optional)</span>
              <select name="event-type">
                <option value="">Not sure yet</option>
                {eventTypes.map((event) => (
                  <option value={event.label}>{event.label}</option>
                ))}
                <option value="Other">Other</option>
              </select>
            </label>
            <label>
              Event date <span class="contact-form-card__optional">(optional)</span>
              <input type="date" name="event-date" />
            </label>
          </div>
          <label>
            Venue / location <span class="contact-form-card__optional">(optional)</span>
            <input type="text" name="venue" maxlength="150" placeholder="e.g. your home, a hall, or the venue name" />
          </label>
          <label>
            Message
            <textarea name="message" rows="4" required maxlength="3000" placeholder="Tell us about your event and what you have in mind..."></textarea>
          </label>
          <button class="btn btn--primary" type="submit">
            <WhatsAppIcon class="btn__icon" />
            Send via WhatsApp
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .contact-details {
    margin: 1.5rem 0;
  }

  .contact-details div {
    margin-bottom: 1rem;
  }

  .contact-details dt {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .contact-details dd {
    margin: 0;
    color: var(--color-muted);
  }

  .contact-form-card form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form-card label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-weight: 500;
    font-size: 0.9rem;
    flex: 1;
  }

  .contact-form-card__row {
    display: flex;
    gap: 1rem;
  }

  .contact-form-card__optional {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .contact-form-card input,
  .contact-form-card select,
  .contact-form-card textarea {
    font: inherit;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .contact-form-card input:focus,
  .contact-form-card select:focus,
  .contact-form-card textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px var(--color-gold-soft);
  }

  @media (max-width: 780px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .contact-form-card__row {
      flex-direction: column;
    }
  }

  .form-banner {
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-size: 0.9rem;
  }

  .form-banner--success {
    background: #eaf6ec;
    color: #1e4620;
  }

  .form-banner--error {
    background: #fbeaea;
    color: #611a1a;
  }
</style>

<script define:vars={{ whatsappLink }}>
  // No server involved: build a WhatsApp message from the form fields and
  // hand off to wa.me, which opens the visitor's own WhatsApp (app on
  // mobile, WhatsApp Web/download prompt on desktop) with that message
  // pre-filled. They still tap send there themselves.
  const form = document.getElementById('contact-form');
  const successBanner = document.getElementById('form-success');
  const errorBanner = document.getElementById('form-error');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    successBanner?.setAttribute('hidden', '');
    errorBanner?.setAttribute('hidden', '');

    const data = new FormData(form);

    // Honeypot: a real visitor never fills this. Do nothing rather than
    // let a bot know it was caught.
    if (data.get('company')?.toString().trim()) {
      return;
    }

    const get = (name) => data.get(name)?.toString().trim() ?? '';
    const name = get('name');
    const email = get('email');
    const message = get('message');

    if (!name || !email || !message) {
      errorBanner?.removeAttribute('hidden');
      return;
    }

    const lines = [
      `Hi Riverstone Event, I'd like to make an enquiry.`,
      '',
      `Enquiry type: ${get('enquiry-type') || 'General Enquiry'}`,
      `Name: ${name}`,
      `Email: ${email}`,
    ];

    const phone = get('phone');
    if (phone) lines.push(`Phone: ${phone}`);

    const eventType = get('event-type');
    if (eventType) lines.push(`Event type: ${eventType}`);

    const eventDate = get('event-date');
    if (eventDate) lines.push(`Event date: ${eventDate}`);

    const venue = get('venue');
    if (venue) lines.push(`Venue/location: ${venue}`);

    lines.push('', 'Message:', message);

    const waUrl = `${whatsappLink}?text=${encodeURIComponent(lines.join('\n'))}`;
    const opened = window.open(waUrl, '_blank', 'noopener');

    if (opened) {
      successBanner?.removeAttribute('hidden');
    } else {
      // Pop-up blocked — fall back to navigating this tab there directly.
      window.location.href = waUrl;
    }
  });
</script>
